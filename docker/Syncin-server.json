{
  "name": "Sync-In Server",
  "repo": "syncin/server:2",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "readme_url": "https://github.com/Sync-in/server",
  "icon": "https://github.com/Fre5h-D/MOS-Templates/blob/main/icons/sync-in.png",
  "category": [ "Productivity" ],
  "project": null,
  "support": "https://github.com/Sync-in/server/issues",
  "description": "Sync-in is a self-hosted platform for file storage, synchronization, and team collaboration.",
   "paths": [
    {
      "name": "Data Directory",
      "mode": "rw",
      "host": "/mnt/data/files/",
      "container": "/app/data",
      "description": "Folder where all files will be stored"
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "protocol": "tcp",
      "host": "8080",
      "container": "8080",
      "description": null
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Europe/Vienna",
      "mask": false,
      "description": "Timezone for the container."
    }
  ],
  "devices": [],
  "gpus": []
}