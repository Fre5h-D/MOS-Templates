{
  "name": "Trilium Notes",
  "repo": "triliumnext/trilium:latest",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "readme_url": "https://github.com/TriliumNext/Trilium",
  "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons/png/trilium-notes.png",
  "category": [ "Productivity" ],
  "project": null,
  "support": "https://github.com/TriliumNext/Trilium/issues",
  "description": "Trilium Notes is a hierarchical note-taking application with a focus on building a large personal knowledge base.",
   "paths": [
    {
      "name": "Data",
      "mode": "rw",
      "host": "/mnt/internal/appdata/trilium",
      "container": "/home/node/trilium-data",
      "description": "Trilium database and settings."
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "protocol": "tcp",
      "host": "8080",
      "container": "8080",
      "description": null
    }
  ],
  "variables": [],
  "devices": [],
  "gpus": []
}