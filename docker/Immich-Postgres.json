{
  "name": "Immich-Postgres",
  "repo": "ghcr.io/immich-app/postgres:18-vectorchord0.5.3-pgvector0.8.1",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --no-healthcheck",
  "post_parameters": null,
  "web_ui_url": null,
  "readme_url": "https://github.com/immich-app/immich",
  "icon": "https://github.com/Fre5h-D/MOS-Templates/blob/main/icons/immich-db.png",
  "category": [ "Utilities" ],
  "project": null,
  "support": "https://github.com/immich-app/immich/issues",
  "description": "Postgres 18 with Vectorchord and PGvector extensions for Immich",
   "paths": [
    {
      "name": "Database",
      "mode": "rw",
      "host": "/mnt/internal/appdata/immich/pgdata",
      "container": "/var/lib/postgresql",
      "description": null
    }
  ],
  "ports": [
    {
      "name": "Database-Port",
      "protocol": "tcp",
      "host": "5432",
      "container": "5432",
      "description": null
    }
  ],
  "variables": [
    {
      "name": "POSTGRES_INITDB_ARGS",
      "key": "POSTGRES_INITDB_ARGS",
      "value": "--data-checksums",
      "mask": false,
      "description": null
    },
    {
      "name": "POSTGRES_PASSWORD",
      "key": "POSTGRES_PASSWORD",
      "value": "password4immichdb",
      "mask": false,
      "description": null
    },
    {
      "name": "POSTGRES_USER",
      "key": "POSTGRES_USER",
      "value": "immich",
      "mask": false,
      "description": null
    },
    {
      "name": "POSTGRES_DB",
      "key": "POSTGRES_DB",
      "value": "immich",
      "mask": false,
      "description": null
    }
  ],
  "devices": [],
  "gpus": []
}
