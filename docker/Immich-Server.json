{
  "name": "Immich-Server",
  "repo": "ghcr.io/immich-app/immich-server:v3",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:2283]/",
  "readme_url": "https://github.com/immich-app/immich",
  "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons/png/immich.png",
  "category": [ "Media" ],
  "project": null,
  "support": "https://github.com/immich-app/immich/issues",
  "description": "High performance self-hosted photo and video management solution.\nAlso needs Immich-Postgres, Immich-MachineLearning and (optional) Valkey/Redis containers to work properly.",
   "paths": [
    {
      "name": "Pictures",
      "mode": "rw",
      "host": "/mnt/data/immich",
      "container": "/data",
      "description": "Folder where all pictures and videos will be stored"
    },
    {
      "name": "Local Time",
      "mode": "ro",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "description": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "protocol": "tcp",
      "host": "2283",
      "container": "2283",
      "description": null
    }
  ],
  "variables": [
    {
      "name": "Postgres-DB Password",
      "key": "DB_PASSWORD",
      "value": "postgres",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres-DB Username",
      "key": "DB_USERNAME",
      "value": "postgres",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres-DB Database Name",
      "key": "DB_DATABASE_NAME",
      "value": "immich",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Postgres-DB Hostname/IP-Address",
      "key": "DB_HOSTNAME",
      "value": null,
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "HPostgres-DB Port",
      "key": "DB_PORT",
      "value": "5432",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Redis/Valkey Hostname/IP-Address",
      "key": "REDIS_HOSTNAME",
      "value": null,
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "Redis/Valkey Port",
      "key": "REDIS_PORT",
      "value": "6379",
      "description": null,
      "required": true,
      "mask": false
    },
    {
      "name": "ML Timeout",
      "key": "MACHINE_LEARNING_WORKER_TIMEOUT",
      "value": "600",
      "description": null,
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "gpus": []
}