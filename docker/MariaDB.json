{
  "name": "MariaDB",
  "repo": "mariadb:11",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": null,
  "readme_url": "https://github.com/MariaDB/mariadb-docker",
  "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons/png/mariadb.png",
  "category": [ "Productivity" ],
  "project": null,
  "support": "https://github.com/MariaDB/mariadb-docker/issues",
  "description": "MariaDB is a community-developed fork of MySQL intended to maintain compatibility while adding new features and improvements.",
   "paths": [
    {
      "name": "DB Data Directory",
      "mode": "rw",
      "host": "/mnt/internal/appdata/mariadb",
      "container": "/var/lib/mysql",
      "description": null
    }
  ],
  "ports": [
    {
      "name": "DB-Port",
      "protocol": "tcp",
      "host": "3306",
      "container": "3306",
      "description": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "1000",
      "mask": false,
      "description": "User ID for the container."
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "1000",
      "mask": false,
      "description": "Group ID for the container."
    },
    {
      "name": "MYSQL_DATABASE",
      "key": "MYSQL_DATABASE",
      "value": "your_database_name_here",
      "mask": false,
      "description": "Name of the database to be created."
    },
    {
      "name": "MYSQL_ROOT_PASSWORD",
      "key": "MYSQL_ROOT_PASSWORD",
      "value": "your_root_password_here",
      "mask": true,
      "description": "Root password for the MariaDB server."
    },
    {
      "name": "MYSQL_USER",
      "key": "MYSQL_USER",
      "value": "your_username_here",
      "mask": false,
      "description": "Username for the database user."
    },
    {
      "name": "MYSQL_PASSWORD",
      "key": "MYSQL_PASSWORD",
      "value": "your_user_password_here",
      "mask": true,
      "description": "Password for the database user."
    }
  ],
  "devices": [],
  "gpus": []
}