{
  "name": "Spoolman",
  "repo": "ghcr.io/donkie/spoolman:latest",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "readme_url": "https://github.com/Donkie/Spoolman",
  "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/spoolman.png",
  "category": [ "Productivity" ],
  "project": null,
  "support": "https://github.com/Donkie/Spoolman/issues",
  "description": "Spoolman is a self-hosted web service designed to help you efficiently manage your 3D printer filament spools and monitor their usage. It acts as a centralized database that seamlessly integrates with popular 3D printing software like OctoPrint and Klipper/Moonraker. When connected, it automatically updates spool weights as printing progresses, giving you real-time insights into filament usage.",
   "paths": [
    {
      "name": "Config",
      "mode": "rw",
      "host": "/mnt/internal/appdata/spoolman",
      "container": "/home/app/.local/share/spoolman",
      "description": "Spoolman configuration, database, and settings."
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "protocol": "tcp",
      "host": "7912",
      "container": "8000",
      "description": ""
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Europe/Vienna",
      "mask": false,
      "description": "Timezone for the container."
    }
  ],
  "devices": [],
  "gpus": []
}